# Build output
# Not anchored with a leading slash: `crates/tinyvoice-module` is a workspace
# member today, but an unanchored rule also covers a nested workspace root if
# one is ever added, whose `target/` a `/target/` rule would silently miss.
target/
**/*.rs.bk
*.pdb

# Coverage output
/coverage/
/coverage.json
*.profraw
*.profdata
lcov.info

# Local secrets — never commit; copy .env.example to .env
.env
.env.local

# Linked worktrees created by the local `worktree` helper
worktrees/*
!worktrees/.gitkeep

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
